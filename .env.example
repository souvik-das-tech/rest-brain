# Copy to .env and edit. Real environment variables override these.

# 127.0.0.1 = this machine only; 0.0.0.0 = reachable from the network (set a username/password first).
BRAIN_HOST=127.0.0.1
BRAIN_PORT=8787

# HTTP Basic auth for every endpoint except /health and the docs. Set both, or neither.
BRAIN_USERNAME=admin
BRAIN_PASSWORD=change-me-to-something-long

BRAIN_MODEL=gemini-3.8-flash-medium
# Browser origins allowed to call the API, comma separated, or *
BRAIN_CORS=
BRAIN_MAX_SESSIONS=10
BRAIN_IDLE_TIMEOUT=1800
BRAIN_TURN_TIMEOUT=150

# Full path to the AGY CLI if it is not on PATH (pm2 may not see a PATH changed after it started).
# BRAIN_AGY=/home/ubuntu/.local/bin/agy
# BRAIN_AGY=C:\Users\you\AppData\Local\agy\bin\agy.exe
